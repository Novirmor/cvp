#!/usr/bin/env bash
# Compatibility entry point for `task onboard`: joins one node to an existing
# cluster through the resumable `cvp_node.py join` workflow.
set -Eeuo pipefail

root_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$root_dir"

fail() {
  printf 'error: %s\n' "$*" >&2
  exit 2
}

node="${CVP_ONBOARD_NODE:-}"
[[ -n "$node" && ${#node} -le 63 && "$node" =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?$ ]] ||
  fail 'set CVP_ONBOARD_NODE to one lowercase inventory host name (letters, digits, hyphens)'
[[ "${CVP_ONBOARD_CONFIRM:-}" == "$node" ]] ||
  fail 'set CVP_ONBOARD_CONFIRM to the same node name after reviewing the host and deployment gates'

if [[ -n "${CVP_ONBOARD_SITE_VARS_FILE:-}" && -n "${CVP_OPERATOR_CONFIG_FILE:-}" ]]; then
  fail 'set only CVP_OPERATOR_CONFIG_FILE; CVP_ONBOARD_SITE_VARS_FILE is a deprecated alias'
fi
if [[ -n "${CVP_ONBOARD_SITE_VARS_FILE:-}" ]]; then
  export CVP_OPERATOR_CONFIG_FILE="$CVP_ONBOARD_SITE_VARS_FILE"
fi
unset CVP_ONBOARD_SITE_VARS_FILE

args=(join "$node" --confirm "$node" --existing-cluster)
if [[ -n "${CVP_ONBOARD_SERVER_CONFIRM:-}" ]]; then
  args+=(--server-confirm "$CVP_ONBOARD_SERVER_CONFIRM")
fi
exec python3 -B scripts/cvp_node.py "${args[@]}"
