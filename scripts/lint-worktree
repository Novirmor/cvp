#!/usr/bin/env bash
set -Eeuo pipefail

root_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root_dir"

# --all-files only includes tracked paths; run hooks over untracked files too.
pre-commit run --all-files

mapfile -d '' -t untracked_files < <(git ls-files --others --exclude-standard -z)
if ((${#untracked_files[@]})); then
  pre-commit run --files "${untracked_files[@]}"
fi
