#!/usr/bin/env bash
set -Eeuo pipefail

root_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root_dir"

policy_dir=tests/policy
expected_violations=(
  hostNetwork
  hostIPC
  hostPID
  hostPath
  privileged
  allowPrivilegeEscalation
  "run as non-root"
  "uid 0"
  seccompProfile
  capabilities
  readOnlyRootFilesystem
  ":latest"
  "pinned by digest"
  "must set requests"
  "must set limits"
  "ephemeral storage"
)

tmp_dir="$(mktemp -d)"
trap 'rm -rf "$tmp_dir"' EXIT

python3 scripts/cluster-manifest-inputs sources
python3 scripts/test-cluster-policy --schema
python3 scripts/test-cluster-guards --schema
python3 scripts/test-cluster-traefik

python3 scripts/test-cluster-manifests
python3 scripts/test-cluster-bootstrap
python3 scripts/cluster-manifest-inputs validate

printf 'checking policy fixtures\n'
conftest test "$policy_dir/fixtures/compliant-workload.yaml" --policy "$policy_dir"

violations="$tmp_dir/noncompliant.out"
if conftest test "$policy_dir/fixtures/noncompliant-workload.yaml" \
  --policy "$policy_dir" > "$violations" 2>&1; then
  echo "non-compliant fixture unexpectedly passed the policy tests" >&2
  exit 1
fi
for marker in "${expected_violations[@]}"; do
  if ! grep -q "$marker" "$violations"; then
    echo "policy tests did not report the expected violation: $marker" >&2
    exit 1
  fi
done
printf 'non-compliant fixture rejected with all %d expected violation types\n' \
  "${#expected_violations[@]}"
