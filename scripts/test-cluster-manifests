#!/usr/bin/env python3
import copy
import json
from pathlib import Path
import runpy
import shutil
import subprocess
import tempfile


ROOT = Path(__file__).resolve().parent.parent
inputs = runpy.run_path(str(ROOT / "scripts/cluster-manifest-inputs"))


def rejected(function, *args, marker):
    try:
        function(*args)
    except ValueError as error:
        assert marker in str(error), str(error)
    else:
        raise AssertionError(f"expected rejection: {marker}")


def namespace_cases(objects):
    check = inputs["check_namespaces"]
    check(objects)
    for kind, marker in (("Namespace", "managed security baseline"), ("NetworkPolicy", "default-deny"), ("ResourceQuota", "ResourceQuota"), ("LimitRange", "LimitRange")):
        bad = [obj for obj in copy.deepcopy(objects) if not (obj["kind"] == kind and (obj["metadata"].get("namespace") == "example" or obj["metadata"]["name"] == "example" and kind == "Namespace"))]
        rejected(check, bad, marker=marker)
    for mode in ("enforce", "audit", "warn"):
        for key, value in ((mode, "privileged"), (mode + "-version", "latest")):
            bad = copy.deepcopy(objects)
            namespace = next(obj for obj in bad if obj["kind"] == "Namespace" and obj["metadata"]["name"] == "example")
            namespace["metadata"]["labels"]["pod-security.kubernetes.io/" + key] = value
            rejected(check, bad, marker="PSA")
    for mutation in (
        lambda o: o["spec"].update(podSelector={"matchLabels": {"unselected": "true"}}),
        lambda o: o["spec"].update(policyTypes=["Ingress"]),
        lambda o: o["spec"].update(egress=[{}]),
    ):
        bad = copy.deepcopy(objects)
        mutation(next(obj for obj in bad if obj["kind"] == "NetworkPolicy" and obj["metadata"].get("namespace") == "example" and obj["metadata"]["name"] == "default-deny"))
        rejected(check, bad, marker="default-deny")
    for namespace in (None, "default", "unmanaged", "flux-system", "kube-system"):
        bad = copy.deepcopy(objects)
        workload = next(obj for obj in bad if obj["kind"] == "Deployment" and obj["metadata"]["name"] == "example")
        if namespace is None:
            workload["metadata"].pop("namespace")
        else:
            workload["metadata"]["namespace"] = namespace
        marker = "explicit namespace" if namespace is None else "system resource" if namespace in {"flux-system", "kube-system"} else "managed security baseline"
        rejected(check, bad, marker=marker)


def graph_cases(directory):
    cluster = directory / "cluster"
    shutil.copytree(ROOT / "cluster", cluster)
    reconciliation = cluster / "flux-system/reconciliation.yaml"
    original = inputs["documents"](reconciliation.read_text())
    fixture = inputs["documents"]((ROOT / "tests/policy/fixtures/compliant-workload.yaml").read_text())[0]
    fixture["spec"]["template"]["spec"]["containers"][0]["image"] = "nginx:latest"
    overlay = cluster / "apps/overlays/new"
    overlay.mkdir()
    (overlay / "kustomization.yaml").write_text("resources:\n- workload.json\n")
    (overlay / "workload.json").write_text(json.dumps(fixture))
    for new_child in (False, True):
        children = copy.deepcopy(original)
        if new_child:
            child = copy.deepcopy(next(obj for obj in children if obj["metadata"]["name"] == "apps"))
            child["metadata"]["name"] = "new-child"
            children.append(child)
        else:
            child = next(obj for obj in children if obj["metadata"]["name"] == "apps")
        child["spec"]["path"] = "./cluster/apps/overlays/new"
        assert child["spec"]["suspend"] is True
        reconciliation.write_text("\n---\n".join(map(json.dumps, children)))
        renders, _ = inputs["render_graph"](cluster)
        assert overlay in renders
        try:
            inputs["validate"](cluster, schema=False)
        except subprocess.CalledProcessError as error:
            assert error.cmd[0] == "conftest", error
        else:
            raise AssertionError("new/repointed suspended Flux overlay escaped validation")
    for path in ("../outside", "/tmp", "https://example.invalid/remote"):
        children = copy.deepcopy(original)
        children[0]["spec"]["path"] = path
        reconciliation.write_text("\n---\n".join(map(json.dumps, children)))
        rejected(inputs["render_graph"], cluster, marker="path")
    for field, value in (("targetNamespace", "default"), ("postBuild", {"substitute": {"namespace": "default"}}), ("kubeConfig", {"secretRef": {"name": "other-cluster"}})):
        children = copy.deepcopy(original)
        children[0]["spec"][field] = value
        reconciliation.write_text("\n---\n".join(map(json.dumps, children)))
        rejected(inputs["render_graph"], cluster, marker="build overrides")
    children = copy.deepcopy(original)
    children[0]["apiVersion"] = "kustomize.toolkit.fluxcd.io/v1beta2"
    children[0]["metadata"]["namespace"] = "example"
    reconciliation.write_text("\n---\n".join(map(json.dumps, children)))
    rejected(inputs["render_graph"], cluster, marker="API version")
    reconciliation.write_text("\n---\n".join(map(json.dumps, original)))
    for reference in ("https://example.invalid/remote", "../../../../outside"):
        (overlay / "kustomization.yaml").write_text(json.dumps({"resources": [reference]}))
        rejected(inputs["render_graph"], cluster, marker="build input")
    (overlay / "kustomization.yaml").write_text("resources:\n- workload.json\n")
    smoke = cluster / "apps/overlays/smoke/kustomization.yaml"
    smoke.write_text(smoke.read_text().replace("namespace: example\n", ""))
    _, objects = inputs["render_graph"](cluster)
    rejected(inputs["check_namespaces"], objects, marker="explicit namespace")


def main():
    _, objects = inputs["render_graph"](ROOT / "cluster")
    namespace_cases(objects)
    with tempfile.TemporaryDirectory(prefix="cvp-graph-tests-") as directory:
        graph_cases(Path(directory))
    print("cluster graph: changed/new suspended paths, build input/override escapes and namespace security regressions passed")


if __name__ == "__main__":
    main()
