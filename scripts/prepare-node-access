#!/usr/bin/env bash
set -Eeuo pipefail

root_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$root_dir"
export ANSIBLE_HOST_KEY_CHECKING=True
export ANSIBLE_SSH_HOST_KEY_CHECKING=True ANSIBLE_TRANSPORT=ssh
inventory_sources=(-i "$root_dir/ansible/defaults/inventory.yml"
  -i "${CVP_INSTANCE_DIR:-$root_dir/examples/instance}/inventory/hosts.yml")

fail() {
  printf 'error: %s\n' "$*" >&2
  exit 2
}

node="${CVP_ACCESS_NODE:-}"
[[ -n "$node" && ${#node} -le 63 && "$node" =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?$ ]] ||
  fail 'set CVP_ACCESS_NODE to one lowercase inventory host name'
[[ "${CVP_ACCESS_CONFIRM:-}" == "$node" ]] ||
  fail 'set CVP_ACCESS_CONFIRM to the same node after reviewing its SSH host key and bootstrap access'

public_key_file="${CVP_ACCESS_PUBLIC_KEY_FILE:-}"
[[ "$public_key_file" == /* && -f "$public_key_file" && -r "$public_key_file" ]] ||
  fail 'CVP_ACCESS_PUBLIC_KEY_FILE must be a readable absolute path to one approved public key'

root_ssh_args=(-e "$(python3 -B scripts/cvp_wrapper_common.py ssh-options root)")
operator_ssh_args=(-e "$(python3 -B scripts/cvp_wrapper_common.py ssh-options ops)")
for identity in ROOT OPERATOR; do
  variable="CVP_ACCESS_${identity}_IDENTITY_FILE"
  path="${!variable:-}"
  [[ -n "$path" ]] || continue
  path="$(python3 -B scripts/cvp_wrapper_common.py external-file "$path")" ||
    fail "$variable must be a readable absolute path outside the repository"
  if [[ "$identity" == ROOT ]]; then
    root_ssh_args=(-e "$(python3 -B scripts/cvp_wrapper_common.py ssh-options root "$path")")
  else
    operator_ssh_args=(-e "$(python3 -B scripts/cvp_wrapper_common.py ssh-options ops "$path")")
  fi
done

keys_json="$(python3 -c '
import json
import pathlib
import sys

lines = pathlib.Path(sys.argv[1]).read_text().splitlines()
if len(lines) != 1 or not lines[0].strip():
    sys.exit("public key file must contain exactly one SSH public key")
print(json.dumps(lines))
' "$public_key_file")" || fail 'invalid public key file'
ssh-keygen -lf "$public_key_file" > /dev/null || fail 'ssh-keygen rejected the public key'

inventory="$(ANSIBLE_CONFIG=ansible/ansible.cfg mise exec -- ansible-inventory \
  "${inventory_sources[@]}" --list)" || fail 'could not read the Ansible inventory'
printf '%s\n' "$inventory" | python3 -B scripts/cvp_wrapper_common.py ssh-inventory
printf '%s\n' "$inventory" | python3 -c '
import json
import sys

data = json.load(sys.stdin)
node = sys.argv[1]
if node not in data.get("wireguard", {}).get("hosts", []):
    sys.exit(f"{node} must be in the wireguard inventory group")
if node in data:
    sys.exit(f"{node}: a node name must not collide with an inventory group")
host = data.get("_meta", {}).get("hostvars", {}).get(node, {})
if host.get("node_name") != node or not host.get("ansible_host"):
    sys.exit(f"{node} needs a matching node_name and an SSH endpoint")
' "$node" || fail 'correct the inventory before preparing access'

printf 'Preparing root-to-ops SSH access on %s without changing network policy...\n' "$node"
mise exec -- task deps
CVP_BOOTSTRAP_ADMIN_KEYS="$keys_json" ANSIBLE_CONFIG=ansible/ansible.cfg \
  mise exec -- ansible-playbook "${inventory_sources[@]}" \
    ansible/playbooks/bootstrap-access.yml --limit "$node" \
    -e ansible_user=root -e ansible_become=false "${root_ssh_args[@]}"

printf 'Verifying operator SSH login and passwordless sudo on %s...\n' "$node"
ANSIBLE_CONFIG=ansible/ansible.cfg mise exec -- ansible \
  "${inventory_sources[@]}" "$node" -m ansible.builtin.shell \
  -a "test \"\$(id -un)\" = ops" -e ansible_user=ops -e ansible_become=false \
  "${operator_ssh_args[@]}"
ANSIBLE_CONFIG=ansible/ansible.cfg mise exec -- ansible \
  "${inventory_sources[@]}" "$node" -m ansible.builtin.shell \
  -a "test \"\$(id -un)\" = root" -e ansible_user=ops -e ansible_become=true \
  "${operator_ssh_args[@]}"

printf 'Operator SSH and sudo access verified for %s.\n' "$node"
