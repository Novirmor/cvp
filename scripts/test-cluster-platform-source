#!/usr/bin/env python3
"""Instance repositories: the pinned cvp-platform Flux source and its tooling.

A scratch copy of this platform is committed to a temporary repository and an
instance is generated from it with scripts/cvp_instance.py, exactly as an
operator would. The validator, bootstrap preflight, readiness check, and
instance check/upgrade commands are then exercised against that instance.
Nothing contacts a cluster or a remote Git host.
"""
import copy
import os
from pathlib import Path
import re
import runpy
import shutil
import subprocess
import sys
import tempfile
import unittest

ROOT = Path(__file__).resolve().parent.parent
IGNORED = {".git", "collections", ".ruff_cache", ".terraform", ".ansible", "__pycache__", ".tofu"}
GIT_ENV = {"GIT_CONFIG_GLOBAL": "/dev/null", "GIT_CONFIG_NOSYSTEM": "1", "GIT_AUTHOR_NAME": "test",
           "GIT_AUTHOR_EMAIL": "test@example.invalid", "GIT_COMMITTER_NAME": "test",
           "GIT_COMMITTER_EMAIL": "test@example.invalid"}


def git(directory, *args):
    return subprocess.run(["git", "-c", "protocol.file.allow=always", "-C", str(directory), *args],
                          check=True, text=True, capture_output=True, env=dict(os.environ, **GIT_ENV)).stdout.strip()


class PlatformSourceTests(unittest.TestCase):
    @classmethod
    def setUpClass(cls):
        cls.workspace = tempfile.TemporaryDirectory(prefix="cvp-platform-source-")
        cls.directory = Path(cls.workspace.name)
        cls.platform = cls.directory / "platform"
        shutil.copytree(ROOT, cls.platform, ignore=lambda _, names: [name for name in names if name in IGNORED])
        git(cls.platform, "init", "-q", "-b", "main")
        git(cls.platform, "add", "-A")
        git(cls.platform, "commit", "-q", "-m", "platform snapshot")
        cls.commit = git(cls.platform, "rev-parse", "HEAD")
        cls.instance = cls.directory / "instance"
        result = subprocess.run([sys.executable, "-B", str(cls.platform / "scripts/cvp_instance.py"), "new",
                                 str(cls.instance), "--name", "example",
                                 "--platform-url", "https://github.com/example/cvp.git"],
                                text=True, capture_output=True, env=dict(os.environ, **GIT_ENV))
        assert result.returncode == 0, result.stdout + result.stderr
        cls.inputs = runpy.run_path(str(ROOT / "scripts/cluster-manifest-inputs"))
        cls.preflight = runpy.run_path(str(ROOT / "scripts/cluster-bootstrap-preflight"))
        cls.readiness = runpy.run_path(str(ROOT / "scripts/cluster-bootstrap-ready"))

    @classmethod
    def tearDownClass(cls):
        cls.workspace.cleanup()

    def setUp(self):
        self.source_file = self.instance / "cluster/flux-system/platform-source.yaml"
        self.original = self.source_file.read_text()
        self.addCleanup(self.source_file.write_text, self.original)

    def render(self, platform=True):
        pin = {"root": self.instance / "platform", "commit": self.commit} if platform else None
        return self.inputs["render_graph"](self.instance / "cluster", pin)

    def instance_tool(self, *args, success=True):
        result = subprocess.run([sys.executable, "-B", str(self.instance / "platform/scripts/cvp_instance.py"), *args],
                                cwd=self.instance, text=True, capture_output=True,
                                env=dict(os.environ, CVP_INSTANCE_DIR=str(self.instance), **GIT_ENV))
        self.assertEqual(result.returncode == 0, success, result.stdout + result.stderr)
        return result.stdout + result.stderr

    # -- generated instance ---------------------------------------------------

    def test_generated_instance_pins_the_submodule_commit_everywhere(self):
        self.assertEqual(git(self.instance, "ls-tree", "HEAD", "platform").split()[2], self.commit)
        self.assertEqual(git(self.instance / "platform", "rev-parse", "HEAD"), self.commit)
        self.assertIn(f"commit: {self.commit}", self.original)
        self.assertEqual(git(self.instance, "config", "-f", ".gitmodules", "submodule.platform.url"),
                         "https://github.com/example/cvp.git")
        # `new` syncs the submodule origin to the public URL so later upgrades
        # fetch from it instead of the local checkout the submodule was added from.
        # Read the raw config: `remote get-url` applies insteadOf rewrites.
        self.assertEqual(git(self.instance / "platform", "config", "--get", "remote.origin.url"),
                         "https://github.com/example/cvp.git")
        graph = (self.instance / "cluster/flux-system/reconciliation.yaml").read_text()
        for name, source in (("policy", "cvp-platform"), ("infrastructure", "cvp-platform"),
                             ("data", "cvp-platform"), ("operations", "cvp-platform"), ("apps", "flux-system")):
            block = re.search(rf"(?ms)^  name: {name}$.*?sourceRef:\n    kind: GitRepository\n    name: (\S+)$", graph)
            self.assertEqual(block.group(1), source, name)
        self.assertIn("INSTANCE_NAME: example", (self.instance / "Taskfile.yml").read_text())
        self.instance_tool("check", success=True)

    # -- validator --------------------------------------------------------------

    def test_validator_renders_platform_layers_from_the_pinned_checkout(self):
        renders, objects = self.render()
        rendered = {path.relative_to(self.instance).as_posix() for path in renders}
        self.assertIn("platform/cluster/infrastructure/policy/overlays/cluster", rendered)
        self.assertIn("cluster/apps/overlays/smoke", rendered)
        self.assertTrue(any(obj["kind"] == "GitRepository" and obj["metadata"]["name"] == "cvp-platform"
                            for obj in objects))

    def test_validator_rejects_unpinned_or_unverifiable_platform_sources(self):
        with self.assertRaisesRegex(ValueError, "needs the platform checkout"):
            self.render(platform=False)
        for change, message in (
            (lambda text: re.sub(r"commit: \w+", "commit: " + "0" * 40, text), "must pin ref.commit"),
            (lambda text: re.sub(r"    commit: \w+", "    branch: main", text), "must pin ref.commit"),
            (lambda text: text.replace("https://", "http://"), "public https"),
            (lambda text: text + "  secretRef:\n    name: flux-system\n", "must not filter"),
            (lambda text: text + "  recurseSubmodules: true\n", "must not filter"),
        ):
            with self.subTest(message=message):
                self.source_file.write_text(change(self.original))
                with self.assertRaisesRegex(ValueError, message):
                    self.render()

    def test_validator_keeps_platform_paths_inside_the_platform_cluster(self):
        graph = self.instance / "cluster/flux-system/reconciliation.yaml"
        original = graph.read_text()
        self.addCleanup(graph.write_text, original)
        graph.write_text(original.replace("path: ./cluster/infrastructure/policy/overlays/cluster",
                                          "path: ./ansible", 1))
        with self.assertRaisesRegex(ValueError, "escapes cluster"):
            self.render()

    # -- bootstrap preflight ----------------------------------------------------

    def published(self):
        snapshot = Path(tempfile.mkdtemp(dir=self.directory))
        git(snapshot, "init", "-q", "--bare", ".git")
        git(snapshot / ".git", "fetch", "-q", str(self.instance), "main")
        return snapshot, git(snapshot / ".git", "rev-parse", "FETCH_HEAD")

    def test_preflight_requires_the_published_and_local_pointers_to_match_the_pin(self):
        pin = self.preflight["platform_pin"](self.instance / "cluster", self.inputs)
        self.assertEqual(pin["commit"], self.commit)
        snapshot, revision = self.published()
        env = dict(os.environ, **GIT_ENV)
        self.preflight["check_platform_pin"](self.instance, snapshot, revision, pin, env)
        with self.assertRaisesRegex(ValueError, "published platform/ submodule pointer"):
            self.preflight["check_platform_pin"](self.instance, snapshot, revision, dict(pin, commit="0" * 40), env)
        git(self.instance / "platform", "commit", "-q", "--allow-empty", "-m", "local drift")
        moved = git(self.instance / "platform", "rev-parse", "HEAD")
        self.addCleanup(git, self.instance / "platform", "checkout", "-q", self.commit)
        self.assertNotEqual(moved, self.commit)
        with self.assertRaisesRegex(ValueError, "local platform/ checkout is not at the pinned commit"):
            self.preflight["check_platform_pin"](self.instance, snapshot, revision, pin, env)

    def test_preflight_fetches_and_validates_exactly_the_pinned_platform_tree(self):
        destination = Path(tempfile.mkdtemp(dir=self.directory)) / "platform"
        env = dict(os.environ, **GIT_ENV)
        self.preflight["fetch_platform"](str(self.platform), self.commit, destination, env)
        exported = (destination / "cluster/infrastructure/policy/base/kustomization.yaml").read_bytes()
        self.assertEqual(exported, (self.platform / "cluster/infrastructure/policy/base/kustomization.yaml").read_bytes())
        self.assertFalse((destination / "ansible").exists())
        renders, _ = self.inputs["render_graph"](self.instance / "cluster",
                                                 {"root": destination, "commit": self.commit})
        self.assertTrue(any(path.is_relative_to(destination) for path in renders))
        with self.assertRaises(subprocess.CalledProcessError):
            self.preflight["fetch_platform"](str(self.platform), "1" * 40,
                                             Path(tempfile.mkdtemp(dir=self.directory)) / "platform", env)

    def test_preflight_rejects_malformed_pins(self):
        for change, message in (
            (lambda text: re.sub(r"    commit: \w+", "    branch: main", text), "exactly one full ref.commit"),
            (lambda text: text.replace("https://", "ssh://"), "public https"),
        ):
            with self.subTest(message=message):
                self.source_file.write_text(change(self.original))
                with self.assertRaisesRegex(ValueError, message):
                    self.preflight["platform_pin"](self.instance / "cluster", self.inputs)

    # -- readiness ----------------------------------------------------------------

    def readiness_fixture(self):
        _, objects = self.render()
        flux_source = next(obj for obj in objects if obj["kind"] == "GitRepository" and obj["metadata"]["name"] == "flux-system")
        platform_source = next(obj for obj in objects if obj["kind"] == "GitRepository" and obj["metadata"]["name"] == "cvp-platform")
        reconciliations = [obj for obj in objects if obj["kind"] == "Kustomization"]
        verified = {"branch": "main", "revision": "a" * 40, "source": flux_source, "reconciliations": reconciliations,
                    "platform": {"url": platform_source["spec"]["url"], "commit": self.commit, "source": platform_source}}

        def live(obj, revision):
            result = copy.deepcopy(obj)
            result["metadata"]["generation"] = 1
            result["status"] = {"observedGeneration": 1, "conditions": [{"type": "Ready", "status": "True",
                                                                        "observedGeneration": 1}]}
            if obj["kind"] == "GitRepository":
                result["status"]["artifact"] = {"revision": revision}
            else:
                result["status"]["lastAppliedRevision"] = revision
            return result

        source = live(flux_source, f"main@sha1:{'a' * 40}")
        platform = live(platform_source, f"sha1:{self.commit}")
        children = {}
        for obj in reconciliations:
            name = obj["spec"]["sourceRef"]["name"]
            revision = f"sha1:{self.commit}" if name == "cvp-platform" else f"main@sha1:{'a' * 40}"
            children[(obj["metadata"]["namespace"], obj["metadata"]["name"])] = live(obj, revision)
        return source, platform, children, verified

    def test_readiness_expects_each_layer_at_its_own_source_revision(self):
        source, platform, children, verified = self.readiness_fixture()
        self.readiness["check"](source, children, verified, platform)
        stale = copy.deepcopy(platform)
        stale["status"]["artifact"]["revision"] = "sha1:" + "b" * 40
        with self.assertRaisesRegex(self.readiness["Pending"], "platform source artifact is not the pinned commit"):
            self.readiness["check"](source, children, verified, stale)
        policy = children[("flux-system", "policy")]
        policy["status"]["lastAppliedRevision"] = f"main@sha1:{'a' * 40}"
        with self.assertRaisesRegex(self.readiness["Pending"], "policy has not applied the verified commit"):
            self.readiness["check"](source, children, verified, platform)

    # -- instance check and upgrade ----------------------------------------------

    def test_check_detects_drift_and_upgrade_moves_every_pin_together(self):
        components = self.instance / "cluster/flux-system/gotk-components.yaml"
        original = components.read_bytes()
        components.write_bytes(original + b"\n# drift\n")
        self.assertIn("differs from the pinned platform copy", self.instance_tool("check", success=False))
        components.write_bytes(original)

        (self.platform / "cluster/flux-system/gotk-components.yaml").write_bytes(original + b"\n# v2\n")
        git(self.platform, "commit", "-q", "-am", "platform v2")
        git(self.platform, "tag", "v2")
        upgraded = git(self.platform, "rev-parse", "HEAD")
        self.addCleanup(lambda: (git(self.instance, "checkout", "-q", "--", "."),
                                 git(self.instance / "platform", "checkout", "-q", self.commit)))
        # The upgrade syncs origin from .gitmodules (the public URL), so rewrite
        # that URL locally — untracked config, keeping the tree clean for the
        # upgrade's gate — to reach the scratch platform without a remote host.
        git(self.instance / "platform", "config", f"url.{self.platform}.insteadOf",
            "https://github.com/example/cvp.git")
        self.addCleanup(git, self.instance / "platform", "config", "--unset",
                        f"url.{self.platform}.insteadOf")
        self.instance_tool("upgrade", "v2")
        self.assertIn(f"commit: {upgraded}", self.source_file.read_text())
        self.assertEqual(git(self.instance / "platform", "rev-parse", "HEAD"), upgraded)
        self.assertTrue(components.read_bytes().endswith(b"# v2\n"))
        # The committed pointer still names the old commit until the operator commits.
        self.assertIn("committed submodule pointer", self.instance_tool("check", success=False))
        git(self.instance, "commit", "-q", "-am", "chore: platform v2")
        self.addCleanup(git, self.instance, "reset", "-q", "--hard", "HEAD~1")
        self.instance_tool("check", success=True)


if __name__ == "__main__":
    unittest.main(verbosity=2)
