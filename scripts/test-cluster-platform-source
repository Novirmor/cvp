#!/usr/bin/env python3
"""Instance repositories: platform.lock pinning and its tooling.

A scratch copy of this platform is committed to a temporary repository and an
instance is generated from it with scripts/cvp_instance.py, exactly as an
operator would: the collection is built and installed, the taskfile copied,
and platform.lock written. The validator, bootstrap preflight, readiness
check, and the instance check/install/upgrade commands are then exercised
against that instance. Nothing contacts a cluster or a remote Git host.
"""
import copy
import json
import os
from pathlib import Path
import re
import runpy
import shutil
import subprocess
import sys
import tempfile
import unittest

ROOT = Path(__file__).resolve().parents[1]
IGNORED = {".git", "collections", ".ruff_cache", ".terraform", ".ansible", "__pycache__", ".tofu", "dist"}
GIT_ENV = {"GIT_CONFIG_GLOBAL": "/dev/null", "GIT_CONFIG_NOSYSTEM": "1", "GIT_AUTHOR_NAME": "test",
           "GIT_AUTHOR_EMAIL": "test@example.invalid", "GIT_COMMITTER_NAME": "test",
           "GIT_COMMITTER_EMAIL": "test@example.invalid"}
PLATFORM_URL = "https://github.com/novirmor/cvp.git"


def git(directory, *args):
    return subprocess.run(["git", "-c", "protocol.file.allow=always", "-C", str(directory), *args],
                          check=True, text=True, capture_output=True, env=dict(os.environ, **GIT_ENV)).stdout.strip()


def instance_tool(instance, platform, *args, success=True):
    """Run cvp_instance against the instance. The installed collection's copy
    is used when present; the bootstrap commands run from the platform tree,
    exactly like a fresh clone's uvx bootstrap."""
    installed = instance / "collections/ansible_collections/cvp/platform/scripts/cvp_instance.py"
    script = installed if installed.is_file() else platform / "scripts/cvp_instance.py"
    result = subprocess.run([sys.executable, "-B", str(script), *args],
                            cwd=instance, text=True, capture_output=True,
                            env=dict(os.environ, CVP_INSTANCE_DIR=str(instance), **GIT_ENV))
    if success:
        assert result.returncode == 0, result.stdout + result.stderr
    else:
        assert result.returncode != 0, result.stdout + result.stderr
    return result.stdout + result.stderr


def lock_values(instance):
    return dict(line.split(" ", 1) for line in (instance / "platform.lock").read_text().splitlines()
                if line.strip() and not line.startswith("#"))


class PlatformLockTests(unittest.TestCase):
    @classmethod
    def setUpClass(cls):
        cls.workspace = tempfile.TemporaryDirectory(prefix="cvp-platform-lock-")
        cls.directory = Path(cls.workspace.name)
        cls.platform = cls.directory / "platform"
        shutil.copytree(ROOT, cls.platform, ignore=lambda _, names: [name for name in names if name in IGNORED])
        git(cls.platform, "init", "-q", "-b", "main")
        git(cls.platform, "add", "-A")
        git(cls.platform, "commit", "-q", "-m", "platform snapshot")
        cls.commit = git(cls.platform, "rev-parse", "HEAD")
        cls.version = (cls.platform / "VERSION").read_text().strip()
        cls.instance = cls.directory / "instance"
        result = subprocess.run([sys.executable, "-B", str(cls.platform / "scripts/cvp_instance.py"), "new",
                                 str(cls.instance), "--name", "example",
                                 "--platform-url", PLATFORM_URL],
                                text=True, capture_output=True, env=dict(os.environ, **GIT_ENV))
        assert result.returncode == 0, result.stdout + result.stderr
        cls.inputs = runpy.run_path(str(ROOT / "scripts/cluster-manifest-inputs"))
        cls.preflight = runpy.run_path(str(ROOT / "scripts/cluster-bootstrap-preflight"))
        cls.readiness = runpy.run_path(str(ROOT / "scripts/cluster-bootstrap-ready"))

    @classmethod
    def tearDownClass(cls):
        cls.workspace.cleanup()

    def setUp(self):
        self.source_file = self.instance / "cluster/flux-system/platform-source.yaml"
        self.original = self.source_file.read_text()
        self.addCleanup(self.source_file.write_text, self.original)

    def render(self, platform=True):
        installed = self.instance / "collections/ansible_collections/cvp/platform"
        pin = None
        if platform:
            # The Flux pin is the rendered graph's source of truth; derive it
            # from the instance file so this stays correct after upgrade tests.
            pinned = re.search(r"(?m)^    commit: ([0-9a-f]{40})$",
                               (self.instance / "cluster/flux-system/platform-source.yaml").read_text())
            pin = {"root": installed, "commit": pinned.group(1)}
        return self.inputs["render_graph"](self.instance / "cluster", pin)

    # -- generated instance ---------------------------------------------------

    def test_new_instance_locks_and_installs_the_platform(self):
        lock = dict(line.split(" ", 1) for line in
                    (self.instance / "platform.lock").read_text().splitlines()
                    if line.strip() and not line.startswith("#"))
        self.assertEqual(lock, {"version": self.version, "commit": self.commit, "url": PLATFORM_URL})
        self.assertFalse((self.instance / ".gitmodules").exists(),
                         "instances must not pin the platform with a submodule")
        installed = self.instance / "collections/ansible_collections/cvp/platform"
        self.assertEqual((installed / "PLATFORM_COMMIT").read_text().strip(), self.commit)
        self.assertEqual((installed / "PLATFORM_VERSION").read_text().strip(), self.version)
        self.assertEqual((self.instance / "tasks/ops.yml").read_bytes(),
                         (installed / "tasks/ops.yml").read_bytes())
        self.assertIn(f"commit: {self.commit}", self.original)
        graph = (self.instance / "cluster/flux-system/reconciliation.yaml").read_text()
        for name, source in (("policy", "cvp-platform"), ("infrastructure", "cvp-platform"),
                             ("data", "cvp-platform"), ("operations", "cvp-platform"), ("apps", "flux-system")):
            block = re.search(rf"(?ms)^  name: {name}$.*?sourceRef:\n    kind: GitRepository\n    name: (\S+)$", graph)
            self.assertIsNotNone(block, name)
            self.assertEqual(block.group(1), source, name)

    def test_check_verifies_every_channel_agrees(self):
        output = instance_tool(self.instance, self.platform, "check")
        self.assertIn("collection, taskfile, and Flux source agree", output)

        def tool_fails_edited(name, path, text):
            with self.subTest(drift=name):
                original = path.read_bytes()
                path.write_text(text)
                self.addCleanup(path.write_bytes, original)
                output = instance_tool(self.instance, self.platform, "check", success=False)
                self.assertIn("error:", output)

        tool_fails_edited("taskfile", self.instance / "tasks/ops.yml", "# drifted\n")
        tool_fails_edited("flux-pin", self.source_file,
                          self.original.replace(self.commit, "b" * 40))
        tool_fails_edited("gotk-copy", self.instance / "cluster/flux-system/gotk-components.yaml",
                          "# drifted\n")
        tool_fails_edited("lock-commit", self.instance / "platform.lock",
                          f"version {self.version}\ncommit {'c' * 40}\nurl {PLATFORM_URL}\n")

    def test_install_rematerializes_a_fresh_clone(self):
        # A fresh clone has platform.lock and no collections/: install rebuilds from the tree.
        shutil.rmtree(self.instance / "collections")
        (self.instance / "tasks/ops.yml").unlink()
        output = instance_tool(self.instance, self.platform, "install", "--tree", str(self.platform))
        self.assertIn(f"cvp.platform {self.version}", output)
        installed = self.instance / "collections/ansible_collections/cvp/platform"
        self.assertEqual((installed / "PLATFORM_COMMIT").read_text().strip(), self.commit)
        self.assertEqual((self.instance / "tasks/ops.yml").read_bytes(),
                         (installed / "tasks/ops.yml").read_bytes())
        instance_tool(self.instance, self.platform, "check")

    # -- validator and bootstrap gates ----------------------------------------

    def test_validator_renders_platform_layers_from_the_installed_collection(self):
        _, objects = self.render()
        kinds = {(obj["kind"], obj["metadata"].get("name")) for obj in objects}
        self.assertIn(("Namespace", "example"), kinds)

    def test_preflight_requires_published_and_local_locks_to_match_the_pin(self):
        pin = self.preflight["platform_pin"](self.instance / "cluster", self.inputs)
        self.assertEqual((pin["url"], pin["commit"]), (PLATFORM_URL, self.commit))
        # The snapshot's bare repository is what verify_published fetches: the
        # published branch with the instance's files.
        snapshot = self.directory / "preflight-snapshot"
        snapshot.mkdir(exist_ok=True)
        subprocess.run(["git", "clone", "-q", "--bare", str(self.instance), str(snapshot / ".git")],
                       check=True, capture_output=True, env=dict(os.environ, **GIT_ENV))
        revision = git(snapshot / ".git", "rev-parse", "HEAD")
        env = dict(os.environ, **GIT_ENV)
        self.preflight["check_platform_pin"](self.instance, snapshot, revision, pin, env)
        with self.assertRaisesRegex(ValueError, "platform.lock commit differs"):
            self.preflight["check_platform_pin"](self.instance, snapshot, revision,
                                                 dict(pin, commit="0" * 40), env)
        original = (self.instance / "platform.lock").read_text()
        try:
            (self.instance / "platform.lock").write_text(original.replace("commit " + self.commit,
                                                                          "commit " + "d" * 40))
            with self.assertRaisesRegex(ValueError, "reviewed platform.lock"):
                self.preflight["check_platform_pin"](self.instance, snapshot, revision, pin, env)
        finally:
            (self.instance / "platform.lock").write_text(original)

    def test_preflight_fetches_and_validates_exactly_the_pinned_platform_tree(self):
        destination = self.directory / "fetched-platform"
        destination.mkdir()
        env = dict(os.environ, **GIT_ENV)
        self.preflight["fetch_platform"](str(self.platform), self.commit, destination, env)
        fetched = (destination / "cluster/flux-system/reconciliation.yaml").read_text()
        self.assertEqual(fetched, (self.platform / "cluster/flux-system/reconciliation.yaml").read_text())
        with self.assertRaises(ValueError):
            self.preflight["fetch_platform"](str(self.platform), "1" * 40,
                                             self.directory / "fetched-wrong", env)

    def test_readiness_expects_each_layer_at_its_own_source_revision(self):
        _, objects = self.render()
        flux_source = next(obj for obj in objects if obj["kind"] == "GitRepository" and obj["metadata"]["name"] == "flux-system")
        platform_source = next(obj for obj in objects if obj["kind"] == "GitRepository" and obj["metadata"]["name"] == "cvp-platform")
        reconciliations = [obj for obj in objects if obj["kind"] == "Kustomization"]
        verified = {"branch": "main", "revision": "a" * 40, "source": flux_source, "reconciliations": reconciliations,
                    "platform": {"url": platform_source["spec"]["url"], "commit": self.commit, "source": platform_source}}

        def live(obj, revision):
            result = copy.deepcopy(obj)
            result["metadata"]["generation"] = 1
            result["status"] = {"observedGeneration": 1, "conditions": [{"type": "Ready", "status": "True",
                                                                        "observedGeneration": 1}]}
            if obj["kind"] == "GitRepository":
                result["status"]["artifact"] = {"revision": revision}
            else:
                result["status"]["lastAppliedRevision"] = revision
            return result

        source = live(flux_source, f"main@sha1:{'a' * 40}")
        platform = live(platform_source, f"sha1:{self.commit}")
        children = {}
        for obj in reconciliations:
            name = obj["spec"]["sourceRef"]["name"]
            revision = f"sha1:{self.commit}" if name == "cvp-platform" else f"main@sha1:{'a' * 40}"
            children[(obj["metadata"]["namespace"], obj["metadata"]["name"])] = live(obj, revision)
        self.readiness["check"](source, children, verified, platform)
        stale = copy.deepcopy(platform)
        stale["status"]["artifact"]["revision"] = "sha1:" + "b" * 40
        with self.assertRaisesRegex(self.readiness["Pending"], "platform source artifact is not the pinned commit"):
            self.readiness["check"](source, children, verified, stale)

    # -- upgrade ---------------------------------------------------------------

    def test_upgrade_moves_every_pin_together(self):
        git(self.platform, "commit", "-q", "--allow-empty", "-m", "platform v2")
        upgraded = git(self.platform, "rev-parse", "HEAD")
        output = instance_tool(self.instance, self.platform, "upgrade", "HEAD", "--tree", str(self.platform))
        self.assertIn(f"-> {self.version} ({upgraded[:12]})", output)
        self.assertIn(f"commit: {upgraded}", self.source_file.read_text())
        installed = self.instance / "collections/ansible_collections/cvp/platform"
        self.assertEqual((installed / "PLATFORM_COMMIT").read_text().strip(), upgraded)
        lock = dict(line.split(" ", 1) for line in (self.instance / "platform.lock").read_text().splitlines()
                    if line.strip() and not line.startswith("#"))
        self.assertEqual(lock["commit"], upgraded)
        instance_tool(self.instance, self.platform, "check")
        # A dirty instance tree refuses to upgrade.
        drift = self.instance / "cluster/apps/README.md"
        original = drift.read_text()
        try:
            drift.write_text(original + "drift\n")
            output = instance_tool(self.instance, self.platform, "upgrade", "HEAD", "--tree", str(self.platform), success=False)
            self.assertIn("commit or stash", output)
        finally:
            drift.write_text(original)


if __name__ == "__main__":
    unittest.main(verbosity=2)
