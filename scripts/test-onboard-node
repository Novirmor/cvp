#!/usr/bin/env bash
set -Eeuo pipefail

root_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
unset CVP_ONBOARD_SERVER_CONFIRM CVP_ONBOARD_SITE_VARS_FILE CVP_OPERATOR_CONFIG_FILE
work_dir="$(mktemp -d)"
trap 'rm -rf "$work_dir"' EXIT
export XDG_CONFIG_HOME="$work_dir/config"
mkdir "$work_dir/bin"

tee "$work_dir/bin/mise" > /dev/null <<'STUB'
#!/usr/bin/env bash
set -Eeuo pipefail
printf '%s\n' "$*" >> "$CVP_ONBOARD_TEST_CALLS"
if [[ "$*" == 'exec -- ansible-inventory -i ansible/inventory/hosts.yml --list' ]]; then
  printf '%s\n' "$CVP_ONBOARD_TEST_INVENTORY"
fi
STUB
chmod +x "$work_dir/bin/mise"

export PATH="$work_dir/bin:$PATH"
export CVP_ONBOARD_TEST_CALLS="$work_dir/calls"
export CVP_ONBOARD_TEST_INVENTORY='{"wireguard":{"hosts":["worker1"]},"k3s_agents":{"hosts":["worker1"]},"k3s_servers":{"hosts":[]},"_meta":{"hostvars":{"worker1":{"node_name":"worker1","node_virtualization":"vm","k3s_role":"agent","k3s_server_init":false,"wireguard_address":"192.0.2.4","wireguard_public_key":"public-key"}}}}'
export CVP_ONBOARD_NODE=worker1

if CVP_ONBOARD_CONFIRM='' bash "$root_dir/scripts/onboard-node" > /dev/null 2>&1; then
  printf '%s\n' 'onboarding proceeded without confirmation' >&2
  exit 1
fi
[[ ! -s "$CVP_ONBOARD_TEST_CALLS" ]] || {
  printf '%s\n' 'onboarding ran commands without confirmation' >&2
  exit 1
}

export CVP_ONBOARD_CONFIRM=worker1
bash "$root_dir/scripts/onboard-node" > /dev/null
mapfile -t calls < "$CVP_ONBOARD_TEST_CALLS"
[[ "${#calls[@]}" -eq 7 ]] || {
  printf 'expected seven ordered calls, got %s\n' "${#calls[@]}" >&2
  exit 1
}
[[ "${calls[0]}" == 'exec -- ansible-inventory -i ansible/inventory/hosts.yml --list' ]]
[[ "${calls[1]}" == 'exec -- task test' ]]
[[ "${calls[2]}" == *'ansible/playbooks/onboard-preflight.yml '* && "${calls[2]}" != *'--limit'* ]]
[[ "${calls[3]}" == *'ansible/playbooks/probe.yml --limit worker1 '* ]]
[[ "${calls[4]}" == *'ansible/playbooks/site.yml '* && "${calls[4]}" != *'--limit'* ]]
[[ "${calls[4]}" == *'"cvp_onboard_node": "worker1"'* ]]
[[ "${calls[5]}" == *'ansible/playbooks/probe-wireguard.yml --limit worker1 '* ]]
[[ "${calls[6]}" == *'ansible/playbooks/verify.yml '* ]]

: > "$CVP_ONBOARD_TEST_CALLS"
export CVP_ONBOARD_TEST_INVENTORY='{"_meta":{"hostvars":{},"profile":"inventory_legacy"},"all":{"children":["ungrouped","wireguard","k3s_servers","k3s_agents","storage_stateful","ingress"]}}'
if bash "$root_dir/scripts/onboard-node" > "$work_dir/empty-inventory-output" 2>&1; then
  printf '%s\n' 'onboarding accepted an empty inventory with missing groups' >&2
  exit 1
fi
[[ "$(< "$work_dir/empty-inventory-output")" == *'worker1 must be in the wireguard group'* ]]
mapfile -t calls < "$CVP_ONBOARD_TEST_CALLS"
[[ "${#calls[@]}" -eq 1 ]] || {
  printf '%s\n' 'onboarding proceeded past empty inventory' >&2
  exit 1
}
[[ "${calls[0]}" == 'exec -- ansible-inventory -i ansible/inventory/hosts.yml --list' ]]

: > "$CVP_ONBOARD_TEST_CALLS"
export CVP_ONBOARD_TEST_INVENTORY='{"wireguard":{"hosts":["worker1"]},"k3s_agents":{"hosts":[]},"k3s_servers":{"hosts":[]},"_meta":{"hostvars":{"worker1":{"node_name":"worker1","node_virtualization":"vm","k3s_role":"agent","k3s_server_init":false,"wireguard_address":"192.0.2.4","wireguard_public_key":"public-key"}}}}'
if bash "$root_dir/scripts/onboard-node" > /dev/null 2>&1; then
  printf '%s\n' 'onboarding accepted an unassigned node' >&2
  exit 1
fi
mapfile -t calls < "$CVP_ONBOARD_TEST_CALLS"
[[ "${#calls[@]}" -eq 1 ]] || {
  printf '%s\n' 'onboarding proceeded past invalid inventory' >&2
  exit 1
}

: > "$CVP_ONBOARD_TEST_CALLS"
export CVP_ONBOARD_TEST_INVENTORY='{"wireguard":{"hosts":["worker1"]},"k3s_agents":{"hosts":[]},"k3s_servers":{"hosts":["worker1"]},"_meta":{"hostvars":{"worker1":{"node_name":"worker1","node_virtualization":"vm","k3s_role":"server","k3s_server_init":false,"wireguard_address":"192.0.2.4","wireguard_public_key":"public-key"}}}}'
if bash "$root_dir/scripts/onboard-node" > /dev/null 2>&1; then
  printf '%s\n' 'onboarding accepted a new server without quorum confirmation' >&2
  exit 1
fi
mapfile -t calls < "$CVP_ONBOARD_TEST_CALLS"
[[ "${#calls[@]}" -eq 1 ]] || {
  printf '%s\n' 'onboarding proceeded past the server gate' >&2
  exit 1
}

: > "$CVP_ONBOARD_TEST_CALLS"
export CVP_ONBOARD_SERVER_CONFIRM=worker1
bash "$root_dir/scripts/onboard-node" > /dev/null
mapfile -t calls < "$CVP_ONBOARD_TEST_CALLS"
[[ "${#calls[@]}" -eq 7 ]] || {
  printf '%s\n' 'confirmed server onboarding did not run its checks' >&2
  exit 1
}

printf '%s\n' 'onboarding guards and task order passed'
