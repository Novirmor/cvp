# Copy outside Git. Choose different absolute paths for Cloudflare and Tailscale.
# OpenTofu encrypts state and plans before writing them. Back up both the state
# file and its separate SOPS-protected state_passphrase.
path          = "/home/operator/.local/state/cvp/midgard/tailscale/state.tfstate"
workspace_dir = "/home/operator/.local/state/cvp/midgard/tailscale/workspaces"
