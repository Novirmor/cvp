---
# Reference for every host variable. `task node-new` generates host_vars files
# and inventory membership for you; use this to understand or hand-edit them.
# The .yml.example suffix keeps this file out of inventory loading; see
# docs/runbooks/nodes.md.

ansible_host: ""            # stable DNS name or address for SSH
ansible_port: 22
node_name: ""               # must equal the inventory host key

# LXC guests and ordinary VMs (or metal) are both supported.
#   lxc   : shares the host kernel; the isolated functional probe may trigger
#           VXLAN autoload, then requires registered overlay, visible VXLAN,
#           and working bridge filtering. It cannot persist module loading.
#   vm    : owns its kernel; the probe requires the modules to be available and
#           convergence loads them and persists them across reboots.
#   metal : like vm, without a hypervisor.
#   auto  : accepts whatever systemd-detect-virt reports.
# Pin the real environment instead of leaving auto: a pinned value that later
# disagrees (provider migration, rebuilt image) fails probe, site, and verify.
node_virtualization: auto   # replace with lxc | vm | metal before onboarding
# Only for a reviewed LXC with one host-owned `none virtual` swap entry:
# k3s_tolerate_virtual_swap: true  # kubelet allows host swap; pods use NoSwap

wireguard_address: ""       # free address in the operator-selected mesh subnet
wireguard_endpoint: ""      # "[public-ipv6]:51820" or "public-ipv4:51820"
wireguard_public_key: ""    # wg pubkey of the private key kept in the secret store

tailscale_address: ""       # assigned at enrollment; recorded afterwards
tailscale_advertise_tags:
  - tag:k3s

k3s_role: agent             # worker-only by default; server requires a reviewed quorum decision
k3s_server_init: false      # true only for the one cluster-init server
k3s_tls_sans: []            # extra API SANs for this node (its wireguard_address on init)

# Node tags. Rules enforced by validation (task test runs it offline):
#   - cvp.novirmor.io/role is derived from k3s_role; declaring it fails validation.
#   - cvp.novirmor.io/ accepts only the boolean catalog tags from ARCHITECTURE.md
#     (compute, storage, stateful, ingress, gpu, system); typos fail validation.
#   - kubernetes.io/ and k8s.io/ keys are reserved by the API.
#   - every label key must match an escaped literal DNS prefix in k3s_managed_label_domains
#     (group_vars/all.yml): declared labels are both applied and reconciled
#     away when removed from inventory, so an unmanaged domain is rejected.
k3s_node_labels:
  - cvp.novirmor.io/compute=true
  # Custom tag domains: first add the escaped prefix to k3s_managed_label_domains
  # in group_vars/all.yml (one reviewed change), then declare labels here, e.g.:
  # - example.com/zone=fra
  # Workloads select custom tags with node selectors or affinity exactly like
  # cvp.novirmor.io tags; removing a declared label reconciles it off the node.
k3s_node_taints: []         # e.g. ["dedicated.example/database:NoSchedule"]

# Storage intent for storage nodes; leave disabled on compute-only nodes.
storage_enabled: false
storage_device: ""          # by-id device path once accepted at the storage gate
storage_manage_device: false

...
