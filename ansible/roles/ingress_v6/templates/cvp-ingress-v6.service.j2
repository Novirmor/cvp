[Unit]
Description=CVP IPv6 to IPv4 ingress forwarder for port {{ ingress_v6_port }}
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/socat TCP6-LISTEN:{{ ingress_v6_port }},fork,max-children={{ ingress_v6_max_children }},reuseaddr,ipv6only=1,bind=[::] TCP4:{{ ingress_v6_target_host }}:{{ ingress_v6_port }},connect-timeout={{ ingress_v6_connect_timeout }}
User=nobody
Group=nogroup
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
TasksMax={{ ingress_v6_max_children | int + 16 }}
MemoryMax={{ ingress_v6_memory_max }}
LimitNOFILE=1024
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
