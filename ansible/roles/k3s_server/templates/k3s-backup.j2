#!/bin/bash
set -Eeuo pipefail

if [[ ${1:-} != --bounded-run ]]; then
  exec timeout --kill-after=15s 900s /bin/bash "$0" --bounded-run
fi

BACKUP_DIR={{ k3s_backup_dir | quote }}
K3S_BINARY={{ k3s_bin_path | quote }}
DATASTORE={{ k3s_datastore | quote }}
DATABASE={{ (k3s_data_dir ~ '/server/db/state.db') | quote }}
CONFIG={{ k3s_config_path | quote }}
RESTORE_GUARD={{ k3s_restore_guard_path | default('/var/lib/cvp/k3s-restore-in-progress') | quote }}
LEGACY_RESTORE_GUARD={{ (k3s_data_dir ~ '/.cvp-restore-in-progress') | quote }}
NODE={{ inventory_hostname | quote }}
TOKEN={{ k3s_server_token_path | quote }}
AGENT_TOKEN={{ k3s_agent_token_server_path | quote }}
AGE_RECIPIENT={{ k3s_backup_age_recipient | quote }}
# The upload command is evaluated by the child bash below, so its variables
# intentionally expand there rather than in this assignment.
# shellcheck disable=SC2016
UPLOAD_COMMAND={{ k3s_backup_upload_command | quote }}
RETENTION_DAYS={{ k3s_backup_retention_days | int }}

umask 077
mkdir -p "$BACKUP_DIR"
exec 9>"$BACKUP_DIR/.backup.lock"
flock -n 9 || { printf '%s\n' 'Another backup is running' >&2; exit 1; }
recovery_clear() {
  python3 - "$RESTORE_GUARD" "$LEGACY_RESTORE_GUARD" <<'PY'
import os, pathlib, stat, sys
paths = list(map(pathlib.Path, sys.argv[1:]))
info = paths[0].parent.lstat()
if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.geteuid() or info.st_mode & 0o077:
    raise SystemExit('Unsafe recovery inhibit directory')
for path in paths:
    try:
        path.lstat()
    except FileNotFoundError:
        continue
    raise SystemExit('Recovery is in progress')
PY
}
recovery_clear
WORK_DIR=$(mktemp -d "$BACKUP_DIR/.work.XXXXXX")
STAMP=$(date -u +%Y%m%dT%H%M%SZ)
BUNDLE_NAME="k3s-${NODE}-${STAMP}-$(cat /proc/sys/kernel/random/uuid)"
BUNDLE="$BACKUP_DIR/$BUNDLE_NAME"
OUTPUT_NAME="$BUNDLE_NAME.tar.gz.age"
OUTPUT="$WORK_DIR/$OUTPUT_NAME"
cleanup() {
  rm -rf "$WORK_DIR"
}
trap cleanup EXIT
trap 'exit 143' TERM
trap 'exit 130' INT

[[ -s "$TOKEN" ]] || { printf '%s\n' 'K3s server token is missing or empty' >&2; exit 1; }
[[ -s "$AGENT_TOKEN" ]] || { printf '%s\n' 'K3s agent token is missing or empty' >&2; exit 1; }
RUNTIME_PID=$(systemctl show --property=MainPID --value k3s.service)
[[ "$RUNTIME_PID" =~ ^[1-9][0-9]*$ ]] || { printf '%s\n' 'K3s has no running main process' >&2; exit 1; }
K3S_RUNTIME_VERSION=$("/proc/$RUNTIME_PID/exe" --version | awk 'NR==1 {print $3}')
[[ "$K3S_RUNTIME_VERSION" == v*+k3s* ]] || { printf '%s\n' 'Cannot identify the serving K3s version' >&2; exit 1; }
install -m 0600 "$TOKEN" "$WORK_DIR/server.token"
install -m 0600 "$AGENT_TOKEN" "$WORK_DIR/agent.token"

STATE_FILE=
if [[ "$DATASTORE" == "etcd" ]]; then
  # etcd snapshot save contacts the local embedded etcd while K3s is serving.
  # An explicit --name is required: on-demand snapshots otherwise start with
  # "on-demand-" and the archive glob below would never match.
  "$K3S_BINARY" etcd-snapshot save --config "$CONFIG" --name k3s-etcd-snapshot \
    --etcd-snapshot-compress=false --etcd-snapshot-dir "$WORK_DIR"
  shopt -s nullglob
  SNAPSHOTS=("$WORK_DIR"/k3s-etcd-snapshot-*)
  [[ -n "${SNAPSHOTS[0]:-}" && -z "${SNAPSHOTS[1]:-}" && -s "${SNAPSHOTS[0]}" ]] || {
    printf '%s\n' 'K3s etcd snapshot is missing, empty, or ambiguous' >&2
    exit 1
  }
  SNAPSHOT=${SNAPSHOTS[0]}
  mv "$SNAPSHOT" "$WORK_DIR/etcd-snapshot"
  "$K3S_BINARY" etcd-snapshot delete --config "$CONFIG" "$(basename "$SNAPSHOT")" >/dev/null 2>&1 || true
  STATE_FILE=etcd-snapshot
else
  # SQLite .backup produces a consistent copy while K3s is serving requests.
  [[ -s "$DATABASE" ]] || { printf '%s\n' 'K3s SQLite database is missing or empty' >&2; exit 1; }
  sqlite3 -readonly "$DATABASE" ".backup '$WORK_DIR/state.db'"
  STATE_FILE=state.db
fi

cmp -s "$TOKEN" "$WORK_DIR/server.token" || { printf '%s\n' 'Server token changed during snapshot' >&2; exit 1; }
cmp -s "$AGENT_TOKEN" "$WORK_DIR/agent.token" || { printf '%s\n' 'Agent token changed during snapshot' >&2; exit 1; }
if ! [[ "$(systemctl show --property=MainPID --value k3s.service)" == "$RUNTIME_PID" ]] || ! recovery_clear; then
  printf '%s\n' 'K3s restarted or recovery began during snapshot' >&2
  exit 1
fi
printf '%s\n' "$NODE" > "$WORK_DIR/node"
printf '%s\n' "$K3S_RUNTIME_VERSION" > "$WORK_DIR/k3s.version"

tar -C "$WORK_DIR" -czf - "$STATE_FILE" server.token agent.token node k3s.version | age -r "$AGE_RECIPIENT" -o "$OUTPUT" -
(
  cd "$WORK_DIR"
  sha256sum "$OUTPUT_NAME" > "$OUTPUT_NAME.sha256"
)
rm -f "$WORK_DIR/$STATE_FILE" "$WORK_DIR/server.token" "$WORK_DIR/agent.token" "$WORK_DIR/node" "$WORK_DIR/k3s.version"
mv -T "$WORK_DIR" "$BUNDLE"

export BACKUP_BUNDLE_DIR="$BUNDLE"
export BACKUP_FILE="$BUNDLE/$OUTPUT_NAME"
export BACKUP_CHECKSUM_FILE="$BACKUP_FILE.sha256"
/bin/bash -o errexit -o nounset -o pipefail -c "$UPLOAD_COMMAND" 9>&-

find "$BACKUP_DIR" -maxdepth 1 -type d -name 'k3s-*' -mtime +"$RETENTION_DAYS" -exec rm -rf -- {} +
find "$BACKUP_DIR" -maxdepth 1 -type f -name 'k3s-*.tar.gz.age' -mtime +"$RETENTION_DAYS" -delete
find "$BACKUP_DIR" -maxdepth 1 -type f -name 'k3s-*.tar.gz.age.sha256' -mtime +"$RETENTION_DAYS" -delete
