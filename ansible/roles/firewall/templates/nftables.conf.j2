#!/usr/sbin/nft -f

# Recreate only the table owned by this role. The add/delete idiom is
# compatible with nftables older than 1.0.7 (which lack `destroy`) and leaves
# K3s/kube-proxy tables untouched during a reload.
add table inet cvp_filter
delete table inet cvp_filter

table inet cvp_filter {
  chain input {
    type filter hook input priority filter; policy drop;

    iifname "lo" accept
    ct state invalid drop
    ct state established,related accept
    ip protocol icmp accept
    meta l4proto ipv6-icmp accept

    # Tailscale carries people to internal services: the Kubernetes API and,
    # on the ingress node, internal applications behind Traefik. No SSH.
    iifname "tailscale0" tcp dport 6443 accept
{% if inventory_hostname in groups.get('ingress', []) and firewall_public_ingress_ports | length > 0 %}
    iifname "tailscale0" tcp dport { {{ firewall_public_ingress_ports | join(', ') }} } accept
{% endif %}
    # WireGuard carries node-to-node cluster traffic only. No SSH.
    iifname "{{ wireguard_interface }}" tcp dport { 6443, 10250 } accept
{% if inventory_hostname in groups.get('k3s_servers', []) %}
    ip saddr {{ k3s_cluster_cidr }} tcp dport 6443 accept
{% endif %}
    # SSH is public-only: the public uplinks, from explicit operator sources.
{% for interface in firewall_external_interfaces %}
{% if firewall_ssh_ipv4_source_cidrs | length > 0 %}
    iifname "{{ interface }}" ip saddr { {{ firewall_ssh_ipv4_source_cidrs | join(', ') }} } tcp dport {{ firewall_ssh_port }} accept
{% endif %}
{% if firewall_ssh_ipv6_source_cidrs | length > 0 %}
    iifname "{{ interface }}" ip6 saddr { {{ firewall_ssh_ipv6_source_cidrs | join(', ') }} } tcp dport {{ firewall_ssh_port }} accept
{% endif %}
{% endfor %}

    # WireGuard is authenticated by its peer keys. Restrict these sets to
    # stable provider endpoint CIDRs when those are available.
{% if firewall_external_ipv4_interface | length > 0 and firewall_wireguard_ipv4_source_cidrs | length > 0 %}
    iifname "{{ firewall_external_ipv4_interface }}" udp dport {{ wireguard_port }} ip saddr { {{ firewall_wireguard_ipv4_source_cidrs | join(', ') }} } accept
{% endif %}
{% if firewall_external_ipv6_interface | length > 0 and firewall_wireguard_ipv6_source_cidrs | length > 0 %}
    iifname "{{ firewall_external_ipv6_interface }}" udp dport {{ wireguard_port }} ip6 saddr { {{ firewall_wireguard_ipv6_source_cidrs | join(', ') }} } accept
{% endif %}
{% if firewall_allow_dhcpv6 | bool and firewall_external_ipv6_interface | length > 0 %}
    iifname "{{ firewall_external_ipv6_interface }}" ip6 saddr fe80::/10 udp sport 547 udp dport 546 accept
{% endif %}

    # Flannel VXLAN and kubelet traffic are underlay-only.
    iifname "{{ wireguard_interface }}" udp dport 8472 accept
{% if inventory_hostname in groups.get('k3s_servers', []) %}
    # Embedded etcd client and peer ports between the multi-master servers.
    iifname "{{ wireguard_interface }}" tcp dport { 2379, 2380 } accept
{% endif %}
{% if inventory_hostname in groups.get('k3s_servers', []) or inventory_hostname in groups.get('k3s_agents', []) %}
    # In-cluster pods (for example metrics-server) reach the local kubelet
    # through the pod bridge rather than the underlay interface.
    ip saddr {{ k3s_cluster_cidr }} tcp dport 10250 accept
{% endif %}
{% if inventory_hostname in groups.get('ingress', []) and firewall_public_ingress_ports | length > 0 %}
    # Public HTTP(S) is the Cloudflare origin only.
{% for interface in firewall_external_interfaces %}
{% if firewall_public_ingress_ipv4_source_cidrs | length > 0 %}
    iifname "{{ interface }}" ip saddr { {{ firewall_public_ingress_ipv4_source_cidrs | join(', ') }} } tcp dport { {{ firewall_public_ingress_ports | join(', ') }} } accept
{% endif %}
{% if firewall_public_ingress_ipv6_source_cidrs | length > 0 %}
    iifname "{{ interface }}" ip6 saddr { {{ firewall_public_ingress_ipv6_source_cidrs | join(', ') }} } tcp dport { {{ firewall_public_ingress_ports | join(', ') }} } accept
{% endif %}
{% endfor %}
{% endif %}
  }

  chain forward {
    type filter hook forward priority filter; policy accept;
    ct state invalid drop
    ct state established,related accept
{% for interface in firewall_external_interfaces %}
    iifname "{{ interface }}" jump public_forward
{% endfor %}
  }

  chain public_forward {
{% if inventory_hostname in groups.get('ingress', []) and firewall_public_ingress_ports | length > 0 %}
    # DNAT rewrites only the destination: the source is still the Cloudflare edge.
{% if firewall_public_ipv4_addresses | length > 0 and firewall_public_ingress_ipv4_source_cidrs | length > 0 %}
    ip saddr { {{ firewall_public_ingress_ipv4_source_cidrs | join(', ') }} } meta l4proto tcp ct status dnat ct original ip daddr { {{ firewall_public_ipv4_addresses | join(', ') }} } ct original proto-dst { {{ firewall_public_ingress_ports | join(', ') }} } accept
{% endif %}
{% if firewall_public_ipv6_addresses | length > 0 and firewall_public_ingress_ipv6_source_cidrs | length > 0 %}
    ip6 saddr { {{ firewall_public_ingress_ipv6_source_cidrs | join(', ') }} } meta l4proto tcp ct status dnat ct original ip6 daddr { {{ firewall_public_ipv6_addresses | join(', ') }} } ct original proto-dst { {{ firewall_public_ingress_ports | join(', ') }} } accept
{% endif %}
{% endif %}
    drop
  }

  chain output {
    type filter hook output priority filter; policy accept;
  }
}
