{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": true,
  "rangeStrategy": "pin",
  "enabledManagers": [
    "ansible-galaxy",
    "dockerfile",
    "github-actions",
    "helm-values",
    "kubernetes",
    "pre-commit",
    "terraform",
    "mise"
  ],
  "managerFilePatterns": {
    "kubernetes": ["(^|/)cluster/.*\\.ya?ml$"]
  },
  "packageRules": [
    {
      "matchManagers": ["kubernetes", "helm-values"],
      "matchDatasources": ["docker"],
      "pinDigests": true
    },
    {
      "matchManagers": ["terraform"],
      "matchDepTypes": ["required_version"],
      "enabled": false
    }
  ],
  "pre-commit": {
    "enabled": true
  }
}
