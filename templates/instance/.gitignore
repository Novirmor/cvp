# Secrets, state, and plans never enter Git. Encrypted *.sops.yaml files do.
# The installed platform is materialized from platform.lock, not committed.
collections/
.platform-state/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
*.tfvars.json
*.backend.hcl
backend.hcl
.terraform/
.tofu/
*.pem
*.key
*.agekey
*.kubeconfig
kubeconfig
.env
.env.*
mise.local.toml
*.retry
*.bak
*~
.DS_Store
